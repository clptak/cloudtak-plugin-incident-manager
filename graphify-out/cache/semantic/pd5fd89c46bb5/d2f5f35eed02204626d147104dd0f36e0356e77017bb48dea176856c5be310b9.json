{"nodes": [{"id": "src_content_help_establishing_search_area_2_statistical_statistical_method", "label": "Statistical Method", "file_type": "rationale", "source_file": "src/content/help/establishing_search_area_2_statistical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draws circles at the IPP from lost-person behavior for the category selected via a thorough LPQ. The 25%, 50%, and 75% zones are the distances that contained that fraction of historical subjects. The 75% zone is typical because it drops extremes and still contains most of the category. Small case counts are unreliable, and this subject is not yet in the dataset. Used after the theoretical method, it should trim the search area."}, {"id": "src_content_help_establishing_search_area_2_statistical_lpb", "label": "Lost Person Behavior", "file_type": "concept", "source_file": "src/content/help/establishing_search_area_2_statistical.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical distances from the IPP by subject category, selected only after the Lost Person Questionnaire is completed. Also the source of WiSAR TARR percentile distances."}], "edges": [{"source": "src_content_help_establishing_search_area_2_statistical_statistical_method", "target": "src_content_help_establishing_search_area_2_statistical_lpb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/help/establishing_search_area_2_statistical.md", "source_location": null, "weight": 1.0}, {"source": "src_content_help_establishing_search_area_2_statistical_statistical_method", "target": "src_content_help_establishing_search_area_0_main_ipp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/help/establishing_search_area_2_statistical.md", "source_location": null, "weight": 1.0}, {"s