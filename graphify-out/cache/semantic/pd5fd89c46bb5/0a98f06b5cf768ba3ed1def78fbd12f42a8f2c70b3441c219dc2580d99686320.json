{"nodes": [{"id": "src_content_help_establishing_search_area_4_deductive_deductive_method", "label": "Deductive Reasoning Method", "file_type": "rationale", "source_file": "src/content/help/establishing_search_area_4_deductive.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The incident management team builds the most likely scenario from all available information, including investigation. Generally the last of the four methods, and more useful when some of the people know the area. Coupled with the other methods it continues to refine the boundary."}, {"id": "src_content_help_establishing_search_area_4_deductive_final_steps_in_establishing_the_search_area", "label": "Draw search area then segment", "file_type": "concept", "source_file": "src/content/help/establishing_search_area_4_deductive.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the four methods, the initial search area is drawn and everything outside it is ROW. The area is usually too large for one resource in one operational period (about 6 to 8 hours), so the next step is to segment it."}], "edges": [{"source": "src_content_help_establishing_search_area_4_deductive_deductive_method", "target": "src_content_help_establishing_search_area_4_deductive_final_steps_in_establishing_the_search_area", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/help/establishing_search_area_4_deductive.md", "source_location": null, "weight": 1.0}, {"source": "src_content_help_establishing_search_area_4_deductive_final_steps_in_establishing_the_search_area", "target": "src_content_help_consensus_summary_row", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/help/establishing_search_area_4_deductive.md", "source_location": null, "weight": 1.0}, {"source": "src_co