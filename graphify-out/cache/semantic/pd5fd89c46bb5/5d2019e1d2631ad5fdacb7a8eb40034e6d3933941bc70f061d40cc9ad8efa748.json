{"nodes": [{"id": "src_content_help_establishing_search_area_0_main_establishing_the_search_area", "label": "Establishing the Search Area", "file_type": "rationale", "source_file": "src/content/help/establishing_search_area_0_main.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first action in the transition from a route and location search to an area search, and it should not be done alone. It assumes a PLS or LKP has been identified as the IPP; without an IPP there is no basis for the area. LPB, the LPQ, terrain, weather, and scenarios are critical. Four methods (theoretical, statistical, subjective, deductive) are applied in that order, and the area common to all four regions is the search-area boundary. Typically uses 1:24,000 topographic maps, reproduced into the IAP once the area is segmented. Extracted from Topics in Inland SAR Management."}, {"id": "src_content_help_establishing_search_area_0_main_ipp", "label": "Initial Planning Point", "file_type": "concept", "source_file": "src/content/help/establishing_search_area_0_main.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The IPP is the PLS or LKP determined during the route and location search. Theoretical and statistical search areas are circles centered on it. The map for the IAP marks the IPP, ICP, and other incident facilities."}, {"id": "src_content_help_establishing_search_area_0_main_topics_in_inland_sar", "label": "Topics in Inland SAR Management", "file_type": "paper", "source_file": "src/content/help/establishing_search_area_0_main.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of the establishing-search-area and segmenting help, cited as http://www.saraz.org/documents/TopicsInInlandSAR.zip."}], "edges": [{"source": "src_content_help_establishing_search_area_0_main_es