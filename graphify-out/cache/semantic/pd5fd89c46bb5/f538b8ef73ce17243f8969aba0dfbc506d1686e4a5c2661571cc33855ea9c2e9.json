{"nodes": [{"id": "src_content_help_area_search_area_searches", "label": "Area Search", "file_type": "rationale", "source_file": "src/content/help/area_search.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Searches where segments are searched rather than routes and locations, after the whole search area is segmented and a consensus probability is taken, assuming the subject is immobile. Only a small number of searches reach this stage. They span several operational periods, many trained resources and agencies, and use Search Theory. The primary tactic is a grid search in the broad sense (helicopter creeping line, ground critical separation, air-scent dog). Hasty tactics such as sign cutting and tracking may also be used. Attributed to FINDEM."}, {"id": "src_content_help_area_search_findem", "label": "FINDEM", "file_type": "paper", "source_file": "src/content/help/area_search.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_help_area_search_search_theory", "label": "Search Theory", "file_type": "concept", "source_file": "src/content/help/area_search.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_content_help_area_search_area_searches", "target": "src_content_help_area_search_findem", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/help/area_search.md", "source_location": null, "weight": 1.0}, {"source": "src_content_help_area_search_area_searches", "target": "src_content_help_area_search_search_theory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/help/area_search.md", "source_location": null, "weight": 1.0}, {"source": "src_content_help_area_search_area_searches", "target": "src_content_help_route_and_location_sear