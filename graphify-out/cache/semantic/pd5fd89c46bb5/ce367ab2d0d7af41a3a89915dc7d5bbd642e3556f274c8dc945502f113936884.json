{"nodes": [{"id": "src_assets_iap_ics209_incident_status_summary", "label": "ICS 209 Incident Status Summary", "file_type": "document", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upward status report for a significant incident so agency and multiagency coordination decision makers can prioritize scarce resources. Not intended for every short incident. Only a limited set of blocks is required, so the form stays flexible. Parts that include investigations or fatalities should be labeled and not released to the public."}, {"id": "src_assets_iap_ics209_macs", "label": "Multiagency Coordination System", "file_type": "concept", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once the ICS 209 leaves the incident it is shared through dispatch centers and MACS elements so support can be coordinated above the incident."}, {"id": "src_assets_iap_ics209_nims", "label": "National Incident Management System", "file_type": "concept", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_assets_iap_ics209_snapshot_in_time", "label": "Snapshot in Time Reporting", "file_type": "rationale", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ICS 209 moves the best verified picture available at signature time to decision makers. It is not a live feed. Communications and MACS should name the authoritative real-time source when the snapshot goes stale. Typically filed once daily or each operational period, not for every very short period."}, {"id": "src_assets_iap_ics209_geospatial_location", "label": "ICS 209 Geospatial Location", "file_type": "concept", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple location formats (state, jurisdiction, lat/long, US National Grid, UTM, legal description) improve interoperability. Attached geospatial files should stay small: perimeter and point of origin, clearly labeled, not large datasets."}, {"id": "src_assets_iap_ics209_strategic_objectives", "label": "ICS 209 Strategic Objectives", "file_type": "concept", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_assets_iap_ics209_resource_commitment_summary", "label": "ICS 209 Resource Commitment Summary", "file_type": "concept", "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_assets_iap_ics209_incident_status_summary", "target": "src_assets_iap_ics209_macs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "weight": 1.0}, {"source": "src_assets_iap_ics209_incident_status_summary", "target": "src_assets_iap_ics209_nims", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "weight": 1.0}, {"source": "src_assets_iap_ics209_incident_status_summary", "target": "src_assets_iap_ics202_incident_action_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/assets/iap/ics209.pdf", "source_location": null, "weight": 1.0}, {"source": "src_assets_iap_ics209_incident_status_summary", "target": "src_assets_iap_ics203_situation_unit", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/asse